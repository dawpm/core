{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dawpm.dev/schema/lockfile.schema.json",
  "title": "dawpm lockfile (dawpm.lock.yaml)",
  "type": "object",
  "required": ["lockfileVersion", "name", "daw", "packages"],
  "additionalProperties": false,
  "properties": {
    "lockfileVersion": { "const": 1 },
    "name":            { "type": "string" },
    "daw":             { "type": "string", "enum": ["fl-studio"] },
    "packages": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["slug", "resolvedUrl", "sha256", "installedAt", "installedFiles"],
        "additionalProperties": false,
        "properties": {
          "slug":           { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*\\/[a-z0-9][a-z0-9-]*$" },
          "resolvedUrl":    { "type": "string", "format": "uri" },
          "sha256":         { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "installedAt":    { "type": "string" },
          "installedFiles": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
