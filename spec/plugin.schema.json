{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dawpm.dev/schema/plugin.schema.json",
  "title": "dawpm plugin (registry yaml)",
  "type": "object",
  "required": ["slug", "name", "description", "author", "license", "download", "install"],
  "additionalProperties": false,
  "properties": {
    "slug":        { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*\\/[a-z0-9][a-z0-9-]*$" },
    "name":        { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "author":      { "type": "string", "minLength": 1 },
    "license":     { "type": "string", "minLength": 1 },
    "homepage":    { "type": "string", "format": "uri" },
    "image":       { "type": "string", "format": "uri" },
    "tags":        { "type": "array", "items": { "type": "string" }, "default": [] },
    "download": {
      "type": "object",
      "required": ["url", "sha256", "size"],
      "additionalProperties": false,
      "properties": {
        "url":    { "type": "string", "format": "uri" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "size":   { "type": "integer", "minimum": 1 }
      }
    },
    "install": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["format", "include"],
        "additionalProperties": false,
        "properties": {
          "format":  { "type": "string", "enum": ["vst", "vst3", "fst"] },
          "include": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "exclude": { "type": "array", "items": { "type": "string" } },
          "strip":   { "type": "integer", "minimum": 0, "default": 0 }
        }
      }
    }
  }
}
