{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dawpm.dev/schema/manifest.schema.json",
  "title": "dawpm manifest (dawpm.yaml)",
  "type": "object",
  "required": ["name", "daw"],
  "additionalProperties": false,
  "properties": {
    "name":        { "type": "string", "minLength": 1 },
    "daw":         { "type": "string", "enum": ["fl-studio"] },
    "description": { "type": "string" },
    "author":      { "type": "string" },
    "license":     { "type": "string" },
    "project":     { "type": "string" },
    "dependencies": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*\\/[a-z0-9][a-z0-9-]*$" },
      "default": []
    }
  }
}
